# Background worker image (shares the base build, different entrypoint)
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
COPY backend/ ./backend/
RUN pip install --upgrade pip && pip install .

WORKDIR /app/backend

CMD ["python", "-m", "app.broker.worker"]
