# Copy to .env for local runs OUTSIDE docker-compose (compose injects its own env).
# All economy tuning lives in game_config.py, not here.

# --- App ---
ENVIRONMENT=local
DEBUG=true

# --- Database (async SQLAlchemy / asyncpg) ---
DATABASE_URL=postgresql+asyncpg://loselose:loselose@localhost:5432/loselose

# --- Message broker (RabbitMQ) ---
# Provide EITHER a full URL (local) ...
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# ... OR the parts (Render sets RABBITMQ_HOST from the broker's hostport):
# RABBITMQ_HOST=lose-lose-rabbitmq:5672
# RABBITMQ_USER=loselose
# RABBITMQ_PASSWORD=change-me

# --- Auth (JWT) ---
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=10080

# --- Market data provider ---
MARKET_PROVIDER=yfinance
# FINNHUB_API_KEY=your-free-key-here
MARKET_CACHE_TTL_S=10

# --- CORS (comma/JSON list of allowed frontend origins) ---
# CORS_ORIGINS=["http://localhost:5173"]
